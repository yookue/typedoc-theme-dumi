{
    "name": "TypedocThemeDumi",
    "entryPoints": [
        "src/index.tsx"
    ],
    "disableSources": true,
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "hideGenerator": false,
    "highlightLanguages": [
        "bash",
        "html",
        "js",
        "json",
        "jsx",
        "ts"
    ],
    "includeVersion": false,
    "navigationLinks": {
        "GitHub": "https://github.com/yookue/typedoc-theme-dumi",
        "Yookue": "https://yookue.com"
    },
    "plugin": [
        "./dist/lib/index.js"
    ],
    "theme": "dumi",
    "logoImage": "https://yookue.github.io/assets/ico/logo-icon.svg",
    "logoWidth": 32,
    "logoHeight": 32,
    "logoTitle": "Typedoc Theme Dumi",
    "navigationLinkTargets": {
        "GitHub": "_blank",
        "Yookue": "_blank"
    },
    "preventModulesLink": true,
    "hideIndexContentTitle": true,
    "footerAlign": "center"
}

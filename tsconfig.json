{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "target": "es2020",
        "lib": ["dom", "es2017"],
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react",
        "jsxFactory": "JSX.createElement",
        "jsxFragmentFactory": "JSX.Fragment",
        "module": "esnext",
        "noImplicitAny": false,
        "noUnusedLocals": true,
        "removeComments": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "coverage",
        "dist",
        "docs-dist"
    ]
}
